# Settings for compose.prod.yaml on the office server. Copy to .env.prod
# (ignored by Git) and edit. No secrets here: they are files in
# LEXORA_SECRETS_DIR, created by infra/server/create-secrets.sh.

# The name office computers use to reach Lexora (in the office DNS or each
# computer's hosts file). HTTPS certificates are issued for it.
LEXORA_HOSTNAME=lexora.cabinet.lan

# The server's address on the office network. Ports are published on this
# address only, never on all interfaces (ADR 0006).
LEXORA_BIND_ADDRESS=192.168.1.10

# Folder holding the secret files (root-owned, mode 0700).
LEXORA_SECRETS_DIR=/etc/lexora/secrets

# Published ports (defaults 443 and 80). Change only for a test machine.
# LEXORA_HTTPS_PORT=443
# LEXORA_HTTP_PORT=80
