# Settings for the Lexora API. Copy to `.env` and fill in, or run
# `npm run setup:dev` from the repository root to generate development values.
# Never commit a real `.env` file.

# development | test | production
NODE_ENV=development
# Address and port the API listens on. Use 0.0.0.0 only inside a container.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent  (debug/trace refused in production)
LOG_LEVEL=info
# Number of trusted reverse proxies in front of the API (0 when reached directly).
TRUST_PROXY=0

# Origin of the web app (scheme://host:port, no path). Requests from any other
# origin are refused. Must be https:// in production.
APP_ORIGIN=http://127.0.0.1:5173

# Least-privilege application role. Must not be a superuser or the owner role.
# Alternatively set DATABASE_URL_FILE to the path of a file holding the URL.
DATABASE_URL=postgresql://lexora_app:<app-password>@127.0.0.1:55432/lexora_dev
# Optional, default 10.
# DATABASE_POOL_MAX=10

# Encrypts second-factor (TOTP) secrets: 32 random bytes, base64.
# Generate with: openssl rand -base64 32   (or set MFA_ENCRYPTION_KEY_FILE).
# Keep a copy outside the server: without it, every second factor must be reset.
MFA_ENCRYPTION_KEY=<base64-32-bytes>
# Only during key rotation: the old key, used to read secrets not yet re-encrypted.
# MFA_ENCRYPTION_KEY_PREVIOUS=<base64-32-bytes>

# Optional session lifetimes (defaults: 30 minutes idle, 10 hours absolute).
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=10

# Optional Argon2id cost (defaults 65536 KiB, 3 iterations). The API refuses
# values below the OWASP minimum (19456 KiB, 2 iterations) in every environment.
# ARGON2_MEMORY_KIB=65536
# ARGON2_ITERATIONS=3

# Schema owner role, used only by migration commands (never by the API).
MIGRATION_DATABASE_URL=postgresql://lexora_owner:<owner-password>@127.0.0.1:55432/lexora_dev
SHADOW_DATABASE_URL=postgresql://lexora_owner:<owner-password>@127.0.0.1:55432/lexora_shadow
