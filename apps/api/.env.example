# Settings for the Lexora API. Copy to `.env` and fill in, or run
# `npm run setup:dev` from the repository root to generate development values.
# Never commit a real `.env` file.

# development | test | production
NODE_ENV=development
# Address and port the API listens on. Use 0.0.0.0 only inside a container.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent  (debug/trace refused in production)
LOG_LEVEL=info
# Number of trusted reverse proxies in front of the API (0 when reached directly).
TRUST_PROXY=0

# Least-privilege application role. Must not be a superuser or the owner role.
# Alternatively set DATABASE_URL_FILE to the path of a file holding the URL.
DATABASE_URL=postgresql://lexora_app:<app-password>@127.0.0.1:55432/lexora_dev
# Optional, default 10.
# DATABASE_POOL_MAX=10

# Schema owner role, used only by migration commands (never by the API).
MIGRATION_DATABASE_URL=postgresql://lexora_owner:<owner-password>@127.0.0.1:55432/lexora_dev
SHADOW_DATABASE_URL=postgresql://lexora_owner:<owner-password>@127.0.0.1:55432/lexora_shadow
