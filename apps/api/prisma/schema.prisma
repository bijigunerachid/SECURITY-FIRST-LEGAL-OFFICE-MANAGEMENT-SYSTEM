// Lexora database schema.
//
// Connection URLs are not set here. Migrations run as the schema owner
// (MIGRATION_DATABASE_URL, see prisma.config.ts); the running API connects as
// the least-privilege application role (DATABASE_URL, see src/lib/database.ts).
//
// Secrets are never stored in usable form: passwords as Argon2id hashes,
// session/reset tokens and recovery codes as SHA-256 hashes, TOTP secrets
// encrypted with AES-256-GCM (key outside the database).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  lawyer
  assistant
}

enum AuditOutcome {
  success
  failure
  denied
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  /// Stored trimmed and lowercased; unique.
  email             String    @unique @db.VarChar(254)
  displayName       String    @map("display_name") @db.VarChar(120)
  role              Role
  /// Argon2id PHC string. Null until the user sets a password with a setup token.
  passwordHash      String?   @map("password_hash")
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  disabledAt        DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions       Session[]
  totp           TotpFactor?
  recoveryCodes  RecoveryCode[]
  passwordTokens PasswordToken[] @relation("tokenFor")
  issuedTokens   PasswordToken[] @relation("tokenIssuedBy")

  memberships      MatterMember[]
  clientsCreated   Client[]          @relation("clientCreatedBy")
  mattersCreated   Matter[]          @relation("matterCreatedBy")
  breakGlassGrants BreakGlassGrant[]

  documentsCreated Document[]        @relation("documentCreatedBy")
  documentsDeleted Document[]        @relation("documentDeletedBy")
  versionsUploaded DocumentVersion[]

  hearingsCreated Hearing[]      @relation("hearingCreatedBy")
  tasksCreated    MatterTask[]   @relation("taskCreatedBy")
  tasksAssigned   MatterTask[]   @relation("taskAssignee")
  tasksCompleted  MatterTask[]   @relation("taskCompletedBy")
  notifications   Notification[]

  feeAgreementsCreated FeeAgreement[] @relation("feeAgreementCreatedBy")
  invoicesCreated      Invoice[]      @relation("invoiceCreatedBy")
  invoicesIssued       Invoice[]      @relation("invoiceIssuedBy")
  paymentsRecorded     Payment[]      @relation("paymentRecordedBy")
  paymentsVoided       Payment[]      @relation("paymentVoidedBy")

  @@map("app_user")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  /// SHA-256 of the session token. The token itself only exists in the cookie.
  tokenHash         Bytes     @unique @map("token_hash")
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the second factor was checked (or enrolled) in this session.
  mfaVerifiedAt     DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  /// Set by re-entering the password (and code); unlocks sensitive actions briefly.
  reauthenticatedAt DateTime? @map("reauthenticated_at") @db.Timestamptz(3)
  /// Random per-session token the browser must echo in X-CSRF-Token.
  csrfToken         String    @map("csrf_token") @db.VarChar(64)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model TotpFactor {
  userId           String    @id @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// AES-256-GCM: 12-byte IV, ciphertext, 16-byte tag.
  secretCiphertext Bytes     @map("secret_ciphertext")
  /// Identifies which encryption key was used (first bytes of its SHA-256).
  keyId            String    @map("key_id") @db.VarChar(16)
  /// Null while enrolment is pending; set once the user proves the code works.
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// Last accepted 30-second time step; a code cannot be used twice.
  lastUsedStep     BigInt?   @map("last_used_step")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("totp_factor")
}

model RecoveryCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash Bytes     @unique @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("recovery_code")
}

/// Single-use token to set a password: account setup or admin-initiated reset.
model PasswordToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  Bytes     @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation("tokenFor", fields: [userId], references: [id], onDelete: Cascade)
  issuedById String?   @map("issued_by_id") @db.Uuid
  issuedBy   User?     @relation("tokenIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("password_token")
}

/// Fixed-window counters for rate limiting. Keys never contain personal data.
model RateLimitBucket {
  key     String   @id @db.VarChar(128)
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limit_bucket")
}

/// Append-only for the application role (INSERT and SELECT only). Each row
/// stores the SHA-256 of the previous row's hash and its own content, so any
/// change or deletion breaks the chain and is detected by verification.
model AuditEvent {
  id          BigInt       @id @default(autoincrement())
  occurredAt  DateTime     @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?      @map("actor_user_id") @db.Uuid
  action      String       @db.VarChar(64)
  targetType  String?      @map("target_type") @db.VarChar(32)
  targetId    String?      @map("target_id") @db.VarChar(64)
  outcome     AuditOutcome
  requestId   String?      @map("request_id") @db.VarChar(64)
  ipAddress   String?      @map("ip_address") @db.VarChar(45)
  metadata    Json?
  prevHash    Bytes        @map("prev_hash")
  hash        Bytes        @unique

  @@index([occurredAt])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_event")
}

// --- Clients and matters (Phase 4) ---------------------------------------------
//
// Access is decided by matter membership (docs/security.md, "Authorization").
// Clients, matters and break-glass grants are never deleted by the
// application (DELETE is revoked for the app role); matters are closed.

enum ClientKind {
  person
  company
}

enum MatterArea {
  civil
  commercial
  criminal
  family
  administrative
  labour
  real_estate
  other
}

enum MatterStatus {
  open
  on_hold
  closed
}

enum MemberRole {
  lead
  member
}

enum PartyRole {
  opposing_party
  opposing_counsel
  co_party
  witness
  expert
  other
}

model Client {
  id               String     @id @default(uuid()) @db.Uuid
  kind             ClientKind
  name             String     @db.VarChar(200)
  /// Lowercased, accents and Arabic diacritics removed: used for searches.
  searchName       String     @map("search_name") @db.VarChar(200)
  identifier       String?    @db.VarChar(64)
  /// Uppercase, separators removed: used for searches.
  searchIdentifier String?    @map("search_identifier") @db.VarChar(64)
  email            String?    @db.VarChar(254)
  phone            String?    @db.VarChar(32)
  address          String?    @db.VarChar(500)
  notes            String?    @db.VarChar(4000)
  createdById      String     @map("created_by_id") @db.Uuid
  createdBy        User       @relation("clientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  matters Matter[]

  @@index([searchName])
  @@index([searchIdentifier])
  @@index([createdById])
  @@map("client")
}

/// Gap-free yearly counter for matter references (2026-0001, 2026-0002, …).
model MatterCounter {
  year      Int @id
  lastValue Int @map("last_value")

  @@map("matter_counter")
}

model Matter {
  id              String       @id @default(uuid()) @db.Uuid
  /// Office reference, generated by the server: YYYY-NNNN.
  reference       String       @unique @db.VarChar(16)
  title           String       @db.VarChar(200)
  area            MatterArea
  status          MatterStatus @default(open)
  /// Hidden even from conflict-search details for non-members.
  restricted      Boolean      @default(false)
  court           String?      @db.VarChar(200)
  courtCaseNumber String?      @map("court_case_number") @db.VarChar(64)
  description     String?      @db.VarChar(4000)
  openedOn        DateTime     @map("opened_on") @db.Date
  closedOn        DateTime?    @map("closed_on") @db.Date
  clientId        String       @map("client_id") @db.Uuid
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdById     String       @map("created_by_id") @db.Uuid
  createdBy       User         @relation("matterCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  members          MatterMember[]
  parties          Party[]
  breakGlassGrants BreakGlassGrant[]
  documents        Document[]
  hearings         Hearing[]
  tasks            MatterTask[]
  notifications    Notification[]
  feeAgreements    FeeAgreement[]
  invoices         Invoice[]

  @@index([clientId])
  @@index([status])
  @@map("matter")
}

/// Who works on a matter. Exactly one lead per matter (partial unique index
/// in the migration); only lawyers and assistants can be members.
model MatterMember {
  matterId String     @map("matter_id") @db.Uuid
  matter   Matter     @relation(fields: [matterId], references: [id], onDelete: Restrict)
  userId   String     @map("user_id") @db.Uuid
  user     User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  role     MemberRole
  addedAt  DateTime   @default(now()) @map("added_at") @db.Timestamptz(3)

  @@id([matterId, userId])
  @@index([userId])
  @@map("matter_member")
}

/// Other people and organisations in a matter (opposing party, counsel, witnesses).
model Party {
  id               String     @id @default(uuid()) @db.Uuid
  matterId         String     @map("matter_id") @db.Uuid
  matter           Matter     @relation(fields: [matterId], references: [id], onDelete: Restrict)
  kind             ClientKind
  name             String     @db.VarChar(200)
  searchName       String     @map("search_name") @db.VarChar(200)
  role             PartyRole
  identifier       String?    @db.VarChar(64)
  searchIdentifier String?    @map("search_identifier") @db.VarChar(64)
  notes            String?    @db.VarChar(1000)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([matterId])
  @@index([searchName])
  @@index([searchIdentifier])
  @@map("party")
}

/// Time-limited, read-only emergency access by an administrator to one
/// matter (decision D2). Needs a reason and a recent re-entry of the
/// password; every grant and every read under it is audited.
model BreakGlassGrant {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  matterId  String    @map("matter_id") @db.Uuid
  matter    Matter    @relation(fields: [matterId], references: [id], onDelete: Restrict)
  reason    String    @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the administrator ends the access early.
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@index([matterId])
  @@map("break_glass_grant")
}

// --- Documents (Phase 5) ---------------------------------------------------------
//
// Files live in private storage under random UUID names (ADR 0004); these
// tables hold their metadata. Versions are immutable; documents are hidden
// (deleted_at), never deleted, by the application.

/// One document in a matter. Its content is its latest version.
model Document {
  id          String    @id @default(uuid()) @db.Uuid
  matterId    String    @map("matter_id") @db.Uuid
  matter      Matter    @relation(fields: [matterId], references: [id], onDelete: Restrict)
  /// The cleaned file name of the first version.
  title       String    @db.VarChar(200)
  createdById String    @map("created_by_id") @db.Uuid
  createdBy   User      @relation("documentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid
  deletedBy   User?     @relation("documentDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  versions DocumentVersion[]

  @@index([matterId])
  @@map("document")
}

/// One uploaded file. Written once, after its type check and malware scan.
model DocumentVersion {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  document     Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  number       Int
  /// Random name of the file in storage. Never derived from the upload.
  storageKey   String   @unique @map("storage_key") @db.Uuid
  /// Cleaned name offered back when downloading.
  fileName     String   @map("file_name") @db.VarChar(200)
  /// Detected from the file's bytes, not taken from the browser.
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    Int      @map("size_bytes")
  sha256       Bytes
  /// Scanner engine and signature version that found the file clean.
  scannedWith  String   @map("scanned_with") @db.VarChar(64)
  scannedAt    DateTime @map("scanned_at") @db.Timestamptz(3)
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([documentId, number])
  @@map("document_version")
}

// --- Hearings, deadlines, tasks and reminders (Phase 6) -------------------------------

enum HearingStatus {
  scheduled
  held
  postponed
  cancelled
}

/// A court hearing. Times are instants (UTC); the office enters and reads
/// them in its own time zone (Africa/Casablanca).
model Hearing {
  id          String        @id @default(uuid()) @db.Uuid
  matterId    String        @map("matter_id") @db.Uuid
  matter      Matter        @relation(fields: [matterId], references: [id], onDelete: Restrict)
  startsAt    DateTime      @map("starts_at") @db.Timestamptz(3)
  title       String        @db.VarChar(200)
  court       String?       @db.VarChar(200)
  room        String?       @db.VarChar(100)
  notes       String?       @db.VarChar(2000)
  status      HearingStatus @default(scheduled)
  /// What happened, filled in after the hearing.
  outcome     String?       @db.VarChar(2000)
  createdById String        @map("created_by_id") @db.Uuid
  createdBy   User          @relation("hearingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([matterId])
  @@index([startsAt])
  @@map("hearing")
}

enum TaskKind {
  /// A legal or procedural deadline (appeal, filing...): reminders to the whole team.
  deadline
  /// Internal work, optionally assigned to one team member.
  task
}

model MatterTask {
  id            String    @id @default(uuid()) @db.Uuid
  matterId      String    @map("matter_id") @db.Uuid
  matter        Matter    @relation(fields: [matterId], references: [id], onDelete: Restrict)
  kind          TaskKind
  title         String    @db.VarChar(200)
  /// Office calendar day; required for deadlines.
  dueOn         DateTime? @map("due_on") @db.Date
  notes         String?   @db.VarChar(2000)
  assigneeId    String?   @map("assignee_id") @db.Uuid
  assignee      User?     @relation("taskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(3)
  completedById String?   @map("completed_by_id") @db.Uuid
  completedBy   User?     @relation("taskCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  createdById   String    @map("created_by_id") @db.Uuid
  createdBy     User      @relation("taskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([matterId])
  @@index([dueOn])
  @@index([assigneeId])
  @@map("matter_task")
}

enum NotificationKind {
  hearing_soon
  deadline_soon
  deadline_overdue
  task_due
  task_assigned
}

/// In-app reminder for one person. The stage key makes each reminder unique,
/// so a worker that runs twice never sends it twice.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  matterId  String           @map("matter_id") @db.Uuid
  matter    Matter           @relation(fields: [matterId], references: [id], onDelete: Restrict)
  kind      NotificationKind
  /// The hearing or task this is about.
  subjectId String           @map("subject_id") @db.Uuid
  /// For example "7d", "1d", "0d", "overdue", "assigned".
  stage     String           @db.VarChar(16)
  /// When the hearing starts or the task is due (for display and ordering).
  dueAt     DateTime         @map("due_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)

  @@unique([userId, subjectId, stage])
  @@index([userId, readAt])
  @@map("notification")
}

/// Periodic background tasks run by the worker (ADR 0008). A worker claims a
/// due task with one atomic UPDATE, so two workers never run it at once.
model ScheduledTask {
  name            String    @id @db.VarChar(64)
  intervalSeconds Int       @map("interval_seconds")
  nextRunAt       DateTime  @map("next_run_at") @db.Timestamptz(3)
  /// Set while a worker runs the task; another worker may take over after it.
  leaseUntil      DateTime? @map("lease_until") @db.Timestamptz(3)
  lastStartedAt   DateTime? @map("last_started_at") @db.Timestamptz(3)
  lastFinishedAt  DateTime? @map("last_finished_at") @db.Timestamptz(3)
  /// "ok" or "error". Error details go to the worker log, never here.
  lastStatus      String?   @map("last_status") @db.VarChar(16)
  lastSummary     String?   @map("last_summary") @db.VarChar(200)

  @@map("scheduled_task")
}

// --- Fees, invoices and payments (Phase 7) ---------------------------------------------
//
// Amounts are whole centimes (MAD). Issued invoices and credit notes are
// frozen by a trigger: only their running totals (credited, received,
// balance) change afterwards, and balance = total - credited - received is
// a CHECK constraint. Numbers are given at issue, without gaps, from a
// counter row updated in the same transaction (see the migration).

enum InvoiceKind {
  invoice
  credit_note
}

enum InvoiceStatus {
  draft
  issued
}

enum LineKind {
  fee
  disbursement
}

enum PaymentKind {
  payment
  refund
}

enum PaymentMethod {
  cash
  cheque
  transfer
  card
  other
}

enum FeeAgreementKind {
  fixed
  hourly
  other
}

/// The office's details printed on invoices. Exactly one row (id 1), created by the migration.
model BillingSettings {
  id                 Int      @id @default(1) @db.SmallInt
  officeName         String?  @map("office_name") @db.VarChar(200)
  address            String?  @db.VarChar(500)
  phone              String?  @db.VarChar(32)
  email              String?  @db.VarChar(254)
  /// Identifiant commun de l'entreprise (15 digits).
  ice                String?  @db.VarChar(15)
  /// Identifiant fiscal.
  taxId              String?  @map("tax_id") @db.VarChar(10)
  /// Taxe professionnelle (patente).
  professionalTaxId  String?  @map("professional_tax_id") @db.VarChar(12)
  barAssociation     String?  @map("bar_association") @db.VarChar(120)
  bankName           String?  @map("bank_name") @db.VarChar(120)
  /// Relevé d'identité bancaire (24 digits).
  rib                String?  @db.VarChar(24)
  /// Basis points: 2000 = 20 %.
  vatRateBasisPoints Int      @default(2000) @map("vat_rate_basis_points")
  paymentTermDays    Int      @default(30) @map("payment_term_days")
  invoiceNote        String?  @map("invoice_note") @db.VarChar(1000)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("billing_settings")
}

/// The written fee agreement (convention d'honoraires) of a matter. Ended, never deleted.
model FeeAgreement {
  id                 String           @id @default(uuid()) @db.Uuid
  matterId           String           @map("matter_id") @db.Uuid
  matter             Matter           @relation(fields: [matterId], references: [id], onDelete: Restrict)
  kind               FeeAgreementKind
  title              String           @db.VarChar(200)
  amountCentimes     BigInt?          @map("amount_centimes")
  hourlyRateCentimes BigInt?          @map("hourly_rate_centimes")
  signedOn           DateTime?        @map("signed_on") @db.Date
  terms              String?          @db.VarChar(4000)
  endedOn            DateTime?        @map("ended_on") @db.Date
  createdById        String           @map("created_by_id") @db.Uuid
  createdBy          User             @relation("feeAgreementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([matterId])
  @@map("fee_agreement")
}

/// Gap-free counter per series ("F" invoices, "AV" credit notes) and office year.
model InvoiceCounter {
  series    String @db.VarChar(4)
  year      Int
  lastValue Int    @map("last_value")

  @@id([series, year])
  @@map("invoice_counter")
}

/// An invoice or a credit note. Drafts can be edited and deleted; issued ones never change.
model Invoice {
  id                    String        @id @default(uuid()) @db.Uuid
  matterId              String        @map("matter_id") @db.Uuid
  matter                Matter        @relation(fields: [matterId], references: [id], onDelete: Restrict)
  kind                  InvoiceKind
  status                InvoiceStatus @default(draft)
  /// F-YYYY-NNNN or AV-YYYY-NNNN, given at issue.
  number                String?       @unique @db.VarChar(20)
  issuedOn              DateTime?     @map("issued_on") @db.Date
  dueOn                 DateTime?     @map("due_on") @db.Date
  /// For a credit note: the issued invoice it corrects.
  creditedInvoiceId     String?       @map("credited_invoice_id") @db.Uuid
  creditedInvoice       Invoice?      @relation("creditNotes", fields: [creditedInvoiceId], references: [id], onDelete: Restrict)
  creditNotes           Invoice[]     @relation("creditNotes")
  notes                 String?       @db.VarChar(2000)
  /// VAT on fee lines, in basis points. Follows the office rate until issued.
  feeVatRateBasisPoints Int           @map("fee_vat_rate_basis_points")
  subtotalCentimes      BigInt        @default(0) @map("subtotal_centimes")
  vatCentimes           BigInt        @default(0) @map("vat_centimes")
  totalCentimes         BigInt        @default(0) @map("total_centimes")
  /// Sum of issued credit notes against this invoice.
  creditedCentimes      BigInt        @default(0) @map("credited_centimes")
  /// Payments minus refunds, ignoring voided ones.
  receivedCentimes      BigInt        @default(0) @map("received_centimes")
  balanceCentimes       BigInt        @default(0) @map("balance_centimes")
  /// Office and client details as printed, frozen at issue.
  seller                Json?
  buyer                 Json?
  createdById           String        @map("created_by_id") @db.Uuid
  createdBy             User          @relation("invoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  issuedById            String?       @map("issued_by_id") @db.Uuid
  issuedBy              User?         @relation("invoiceIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines    InvoiceLine[]
  payments Payment[]

  @@index([matterId])
  @@index([status, issuedOn])
  @@index([creditedInvoiceId])
  @@map("invoice")
}

model InvoiceLine {
  id                 String   @id @default(uuid()) @db.Uuid
  invoiceId          String   @map("invoice_id") @db.Uuid
  invoice            Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position           Int
  kind               LineKind
  description        String   @db.VarChar(500)
  quantityHundredths Int      @map("quantity_hundredths")
  unitPriceCentimes  BigInt   @map("unit_price_centimes")
  vatRateBasisPoints Int      @map("vat_rate_basis_points")
  netCentimes        BigInt   @map("net_centimes")

  @@unique([invoiceId, position])
  @@map("invoice_line")
}

/// Money received for an invoice, or refunded. Never changed or deleted; a mistake is voided with a reason.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  kind           PaymentKind
  receivedOn     DateTime      @map("received_on") @db.Date
  amountCentimes BigInt        @map("amount_centimes")
  method         PaymentMethod
  reference      String?       @db.VarChar(100)
  notes          String?       @db.VarChar(500)
  recordedById   String        @map("recorded_by_id") @db.Uuid
  recordedBy     User          @relation("paymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedById     String?       @map("voided_by_id") @db.Uuid
  voidedBy       User?         @relation("paymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason     String?       @map("void_reason") @db.VarChar(300)

  @@index([invoiceId])
  @@index([receivedOn])
  @@map("payment")
}
