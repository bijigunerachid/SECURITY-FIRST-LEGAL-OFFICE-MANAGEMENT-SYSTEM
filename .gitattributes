# Normalise text to LF in the repository and working tree, so scripts and
# config files behave the same inside Linux containers as on Windows.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never convert, never diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.odt  binary
*.woff binary
*.woff2 binary
*.gz   binary
